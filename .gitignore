# ============================================================
#  Sensitive credentials & secrets  (dfs-bootstrap §Phase 1)
#  This block MUST stay byte-identical to $requiredIgnores
#  in the DFS bootstrap script (single source of truth).
#  Do not reorder, do not comment out.
# ============================================================
config.yaml
config.yml
config.local.yaml
.env
.env.*
*.env
*.secret
*.pem
*.key
*.local.json
credentials.json

# ============================================================
#  Language runtime artifacts
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ============================================================
#  Agent / harness scratch (never publish local state)
# ============================================================
.worktrees/
.agent-cache/
*.local.md

# ============================================================
#  Generated per-machine state — kept on disk, never published.
#  dfs-bootstrap writes these with {vault_root} RESOLVED to the
#  local absolute path, so committing them would ship one
#  machine's layout as if it were everyone's. Regenerate with
#  dfs-bootstrap instead of tracking them.
# ============================================================
AGENTS.md
CLAUDE.md
.agent-rules.md
.cursorrules
WORKMEMORY/
HANDOFF.md

# ============================================================
#  Port-local runtime state
#  routing.json holds YOUR tag→destination table (scripts/README.md);
#  the ledger and transaction journal are per-project working state.
# ============================================================
routing.json
.vault-exec-ledger.json
.vault-tx/

# ============================================================
#  OS / editor
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~
